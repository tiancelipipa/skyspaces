* text=auto

# Source and project text files stay LF across platforms.
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.inl text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
.gitignore text eol=lf

# Windows batch files need CRLF for cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary assets should never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.ico binary
*.mp4 binary
*.avi binary
*.mov binary
*.vdb binary
*.nvdb binary
*.lib binary
*.dll binary
*.exe binary
